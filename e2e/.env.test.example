# Environment for the Playwright e2e run. Copy to .env.test and fill in.
#
# test-env.ts parses this file and playwright.config.ts passes the values to the
# API web server, whose command resets and seeds the database below before it
# starts. Point DATABASE_URL at a throwaway database, never at the development
# one.
NODE_ENV=test

# Must match API_PORT in playwright.config.ts.
PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/intranet_test?schema=public

BETTER_AUTH_SECRET=

# The Vite server playwright.config.ts starts, not the usual :5173.
BETTER_AUTH_URL=http://localhost:5174

# Placeholders are enough: the e2e run never completes a real Zoho round trip,
# and the values only have to satisfy the schema in server/src/lib/env.ts.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=test-zoho-client-id
ZOHO_CLIENT_SECRET=test-zoho-client-secret

ALLOWED_EMAIL_DOMAIN=dahnay.com

# The seed runs after every reset, so these are required.
SEED_ADMIN_EMAIL=admin@dahnay.com
SEED_ADMIN_NAME=Test Admin
