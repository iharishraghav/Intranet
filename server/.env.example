# development | test | production. Rate limiting and the `trust proxy` setting
# are only active when this is `production`.
NODE_ENV=development

PORT=3000

# PostgreSQL connection string, used by both Prisma migrations and the API.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/intranet?schema=public

# Session encryption secret, minimum 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin Better Auth builds its URLs from. In development this is the Vite dev
# server, not the API port: the browser only ever talks to :5173, which proxies
# /api through to this server. In production, set it to the deployed app URL.
BETTER_AUTH_URL=http://localhost:5173

# Zoho SSO. The accounts URL is data-center specific -- accounts.zoho.in (India),
# accounts.zoho.com (US), accounts.zoho.eu (Europe), accounts.zoho.com.au, etc.
# Register the app at the matching console (api-console.zoho.in) as a
# "Server-based Application" with this authorized redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/zoho
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# The single email domain permitted to sign in. Re-checked on every sign-in, not
# just the first, so changing it locks out linked accounts immediately. An
# address outside this domain is rejected with the same message as an
# unprovisioned one, so outsiders cannot enumerate staff.
ALLOWED_EMAIL_DOMAIN=dahnay.com

# Address provisioned as an Admin by `npm run db:seed`, which also runs after
# every `prisma migrate dev`. Since sign-up is disabled, this is how the first
# person gets in at all -- everyone else is added to the user table by hand.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
