PORT=3000

# PostgreSQL connection string, used by both Prisma migrations and the API.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/intranet?schema=public

# Session encryption secret, minimum 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin Better Auth builds its URLs from. In development this is the Vite dev
# server, not the API port: the browser only ever talks to :5173, which proxies
# /api through to this server. In production, set it to the deployed app URL.
BETTER_AUTH_URL=http://localhost:5173

# Zoho SSO. The accounts URL is data-center specific -- accounts.zoho.in (India),
# accounts.zoho.com (US), accounts.zoho.eu (Europe), accounts.zoho.com.au, etc.
# Register the app at the matching console (api-console.zoho.in) as a
# "Server-based Application" with this authorized redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/zoho
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Comma-separated list of email domains permitted to sign in. Enforced on every
# sign-in, not just the first.
#
# Note this is a second line of defence, not the primary gate: sign-up is
# disabled, so the user table is an allowlist. A person with a valid Zoho account
# on an allowed domain still cannot sign in until they are provisioned in
# prisma/seed.ts.
ALLOWED_EMAIL_DOMAINS=dahnay.com
